
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasApprovedRole(allowedRoles) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in allowedRoles;
    }

    // Pengguna hanya boleh membaca dokumen role miliknya sendiri.
    // Perubahan role harus dilakukan administrator tepercaya.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Flutter hanya membaca data; penulisan dilakukan oleh proses
    // server Computer Vision menggunakan Firebase Admin SDK.
    match /visitor_activity/{documentId} {
      allow read: if hasApprovedRole(['admin', 'operator', 'viewer']);
      allow create, update, delete: if false;
    }

    match /visitor_state/{documentId} {
      allow read: if hasApprovedRole(['admin', 'operator', 'viewer']);
      allow create, update, delete: if false;
    }

    // Tolak akses terhadap koleksi lain yang belum diizinkan.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
